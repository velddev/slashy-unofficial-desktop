{
  // Type-checking only (npm run typecheck); esbuild does the building (build.mjs) and Node runs test.ts directly,
  // which is why only erasable syntax is allowed (no enums/namespaces) and imports carry .ts extensions.
  "compilerOptions": {
    "target": "ES2023",
    "module": "preserve",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"]
  },
  "include": ["src", "test.ts"]
}
